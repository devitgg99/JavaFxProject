<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.javafxproject.controller.FruitsMarketController">
    <left>
    </left>

    <center>
        <VBox BorderPane.alignment="CENTER" spacing="10.0">
            <children>
                <!-- Header Section -->
                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 20; -fx-background-color: #F8F8F8;">
                    <children>
                        <Label text="Fruits Market">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="searchTextField" promptText="Type here to search" prefWidth="200.0" />
                        <Button onAction="#search" text="Search" style="-fx-background-color: #D3D3D3;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="language English" />
                        <Label text="My Account" />
                        <HBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Button fx:id="cartToggleBtn" onAction="#toggleCart" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                                    <graphic>
                                        <StackPane>
                                            <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                                                <image>
                                                    <Image url="@icons/shopping_cart.png" />
                                                </image>
                                            </ImageView>
                                            <Label fx:id="cartItemCountLabel" text="0" textFill="WHITE"
                                                   style="-fx-background-color: #ff6b6b; -fx-background-radius: 10; -fx-min-width: 18; -fx-min-height: 18; -fx-alignment: center; -fx-font-size: 10; -fx-font-weight: bold;"
                                                   translateX="10.0" translateY="-10.0" visible="false">
                                            </Label>
                                        </StackPane>
                                    </graphic>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- Promotional Banners -->
                <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 20;">
                    <children>
                        <Pane prefHeight="80.0" prefWidth="250.0" style="-fx-background-color: #E0E0E0; -fx-background-radius: 10;">
                            <children>
                                <Label layoutX="20.0" layoutY="20.0" text="Free delivery" />
                                <Label layoutX="20.0" layoutY="40.0" text="over $20 order" />
                                <ImageView fitHeight="40.0" fitWidth="40.0" layoutX="190.0" layoutY="20.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@icons/delivery.png" />
                                    </image>
                                </ImageView>
                            </children>
                        </Pane>
                        <Pane prefHeight="80.0" prefWidth="250.0" style="-fx-background-color: #D4EDDA; -fx-background-radius: 10;">
                            <children>
                                <Label layoutX="20.0" layoutY="20.0" text="Shopping online" textFill="#28a745" />
                                <Label layoutX="20.0" layoutY="40.0" text="get your shopping in same day" textFill="#28a745" />
                                <ImageView fitHeight="40.0" fitWidth="40.0" layoutX="190.0" layoutY="20.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@icons/online_shopping.png" />
                                    </image>
                                </ImageView>
                            </children>
                        </Pane>
                    </children>
                </HBox>

                <!-- Selected Fruit Section -->
                <VBox alignment="CENTER" spacing="10.0" style="-fx-padding: 10;">
                    <children>
                        <Label fx:id="selectedFruitNameLabel" text="No fruit selected" style="-fx-font-size: 16;" />
                        <Label fx:id="selectedFruitPriceLabel" text="{$0.00}" style="-fx-font-size: 14;" />
                        <ImageView fx:id="selectedFruitImageView" fitHeight="100.0" fitWidth="100.0" preserveRatio="true" />
                        <HBox alignment="CENTER" spacing="10.0">
                            <TextField fx:id="quantityKgTextField" promptText="Enter quantity" prefWidth="100.0" />
                            <Button onAction="#addToCart" text="Add to Cart" style="-fx-background-color: #ff9500; -fx-text-fill: white;" />
                        </HBox>
                    </children>
                </VBox>

                <!-- Fruits Grid -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="fruitGrid" hgap="20.0" vgap="20.0" alignment="TOP_LEFT" style="-fx-padding: 20;">
                        </FlowPane>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>

    <!-- Cart Sidebar (Right Panel) -->
    <right>
        <VBox fx:id="cartSidebar" prefWidth="400.0" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 0 1;"
              visible="false" managed="false">
            <children>
                <!-- Cart Header -->
                <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #f8f9fa; -fx-padding: 20;">
                    <children>
                        <Label text="Cart" textFill="#333333">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="orderNumberLabel" text="Order #3241" textFill="#999999">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <Button fx:id="closeCartBtn" onAction="#toggleCart" text="✕"
                                style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-font-size: 16; -fx-font-weight: bold;" />
                    </children>
                </HBox>

                <!-- Delivery Options -->
                <HBox alignment="CENTER_LEFT" spacing="0.0" style="-fx-background-color: #f8f9fa; -fx-padding: 0 20 20 20;">
                    <children>
                        <Button fx:id="deliveryBtn" mnemonicParsing="false" onAction="#selectDelivery"
                                style="-fx-background-color: #333333; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 16;"
                                text="Delivery" />
                        <Button fx:id="dineInBtn" mnemonicParsing="false" onAction="#selectDineIn"
                                style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-background-radius: 20; -fx-padding: 8 16;"
                                text="Dine in">
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </Button>
                        <Button fx:id="takeAwayBtn" mnemonicParsing="false" onAction="#selectTakeAway"
                                style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-background-radius: 20; -fx-padding: 8 16;"
                                text="Take away">
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>

                <!-- Cart Items List -->
                <ScrollPane fx:id="cartItemsScrollPane" fitToWidth="true" style="-fx-background-color: white;" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="cartItemsContainer" spacing="0.0">
                            <!-- Cart items will be added here dynamically -->
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- Empty Cart Message -->
                <VBox fx:id="emptyCartMessage" alignment="CENTER" spacing="20.0" style="-fx-padding: 40;"
                      visible="true" VBox.vgrow="ALWAYS">
                    <children>
                        <ImageView fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" opacity="0.5">
                            <image>
                                <Image url="@icons/shopping_cart.png" />
                            </image>
                        </ImageView>
                        <Label text="Your cart is empty" textFill="#999999">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Label>
                        <Label text="Add some delicious fruits!" textFill="#cccccc">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <!-- Order Summary -->
                <VBox fx:id="orderSummary" spacing="10.0" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #f0f0f0; -fx-border-width: 1 0 0 0;"
                      visible="false">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Items" textFill="#666666">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="itemsTotalLabel" text="{$0.00}" textFill="#333333">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Discount" textFill="#666666">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="discountLabel" text="- $0.00" textFill="#ff6b6b">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <Separator />

                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="Total" textFill="#333333">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="totalLabel" text="{$0.00}" textFill="#333333">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Place Order Button -->
                <Button fx:id="placeOrderBtn" mnemonicParsing="false" onAction="#placeOrder"
                        prefHeight="50.0"
                        style="-fx-background-color: #ff9500; -fx-text-fill: white; -fx-background-radius: 25; -fx-font-size: 16; -fx-font-weight: bold;"
                        text="Place an order" maxWidth="Infinity" visible="false">
                    <VBox.margin>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </right>
</BorderPane>