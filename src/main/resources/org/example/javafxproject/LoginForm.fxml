<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.javafxproject.controller.LoginController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Login Form" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label text="Email"/>
    <TextField fx:id="emailField" promptText="Enter your email"/>

    <Label text="Password"/>
    <PasswordField fx:id="passwordField" promptText="Enter your password"/>

    <Button fx:id="loginButton" text="Login" onAction="#handleLogin" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
</VBox>